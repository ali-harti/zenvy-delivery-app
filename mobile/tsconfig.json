{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "@api/*": [
        "api/*"
      ],
      "@auth/*": [
        "auth/*"
      ],
      "@components/*": [
        "shared/components/*"
      ],
      "@theme/*": [
        "shared/theme/*"
      ],
      "@utils/*": [
        "shared/utils/*"
      ],
      "@config/*": [
        "config/*"
      ],
      "@realtime/*": [
        "realtime/*"
      ],
      "@shared/*": [
        "shared/*"
      ],
      "@ui/*": [
        "shared/ui/*"
      ],
      "@ui": [
        "shared/ui/index"
      ],
      "@theme": [
        "shared/theme/index"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  }
}