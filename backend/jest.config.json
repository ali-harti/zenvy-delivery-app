{
    "testEnvironment": "node",
    "testMatch": [
        "**/tests/**/*.test.js"
    ],
    "globalSetup": "./tests/setup.js",
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
        "/node_modules/",
        "/tests/"
    ],
    "testTimeout": 30000,
    "verbose": true,
    "forceExit": true,
    "detectOpenHandles": true
}