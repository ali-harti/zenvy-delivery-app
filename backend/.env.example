# ==============================================================================
# ZENVY DELIVERY BACKEND CONFIGURATION
# Portfolio & Local Execution Environment
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development
API_VERSION=v1
TRUST_PROXY_HOPS=1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=zenvy_db
DB_DIALECT=postgres
DATABASE_URL=postgresql://postgres:your_secure_db_password@localhost:5432/zenvy_db

# Security & Authentication (JWT)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars_long
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
BCRYPT_ROUNDS=10

# CORS Whitelist (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:19006,exp://localhost:19000

# Socket.io Configuration
SOCKET_IO_CORS_ORIGIN=*

# Third-Party Integrations
GOOGLE_MAPS_KEY=your_google_maps_api_key_here
