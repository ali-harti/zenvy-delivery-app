# ==============================================================================
# ZENVY DELIVERY PLATFORM - ROOT ENVIRONMENT TEMPLATE
# For local development and portfolio testing only
# ==============================================================================

# Backend Port & Host
BACKEND_PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=zenvy_db
POSTGRES_PORT=5432

# Backend JWT Secrets
JWT_SECRET=your_jwt_secret_min_32_chars_long
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Mobile Client API Target (replace with LAN IP for physical device testing)
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000
